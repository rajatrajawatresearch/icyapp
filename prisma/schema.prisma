generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPER_ADMIN
  /// Delivery partner: sees only orders assigned to them (/delivery).
  DELIVERY
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PAID
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum FulfilmentType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  UPI
}

enum PaymentStatus {
  PENDING
  PAID
}

model Customer {
  id                String             @id @default(cuid())
  name              String
  phone             String
  /// Private-link bearer credential: /u/<token>
  token             String             @unique
  isActive          Boolean            @default(true)
  /// SHA-256 of the device cookie that first opened the link. The link then
  /// works on that device only; null = nobody has opened it yet.
  deviceHash        String?
  deviceBoundAt     DateTime?
  /// When the link was issued, regenerated or restored. Only orders finished
  /// after this can close it.
  linkSince         DateTime           @default(now())
  /// Set when the customer's last order is finished: from this moment the link
  /// no longer opens (see lib/link-expiry.ts). Null = stays open.
  linkExpiresAt     DateTime?
  scheduledDeleteAt DateTime?
  createdAt         DateTime           @default(now())
  orders            Order[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@index([scheduledDeleteAt])
}

model Admin {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              Role               @default(ADMIN)
  /// Deactivated admins cannot sign in; rows are kept for audit history.
  isActive          Boolean            @default(true)
  /// SHA-256 of this account's private sign-in link token (/a/<token>). Only
  /// the hash is stored: the link gives full access, so it is shown once.
  accessTokenHash   String?            @unique
  accessTokenAt     DateTime?
  /// Bumped to end every session of this account (link refreshed, password changed).
  sessionVersion    Int                @default(0)
  /// For role ADMIN: the sections of the panel this person may use, chosen by
  /// a super admin (lib/modules.ts). Super admins always have everything.
  modules           String[]           @default(["orders", "products", "customers", "delivery"])
  /// Set while the account waits to be deleted (same safety window as other
  /// rows): it cannot sign in, and is removed when the time passes.
  scheduledDeleteAt DateTime?
  createdAt         DateTime           @default(now())
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  products          Product[]
  confirmedPayments Payment[]
  auditLogs         AuditLog[]
  deliveries        Order[]            @relation("DeliveryAssignments")
  locationPings     LocationPing[]
}

model Product {
  id                String      @id @default(cuid())
  /// Who added it. Null once that account has been deleted.
  adminId           String?
  admin             Admin?      @relation(fields: [adminId], references: [id], onDelete: SetNull)
  name              String
  price             Decimal     @db.Decimal(10, 2)
  /// Units left. Null = stock is not tracked, so the product never sells out.
  stockQty          Int?
  imageUrl          String?
  isActive          Boolean     @default(true)
  category          String      @default("General")
  scheduledDeleteAt DateTime?
  createdAt         DateTime    @default(now())
  orderItems        OrderItem[]

  @@index([scheduledDeleteAt])
}

model Order {
  id                String         @id @default(cuid())
  /// Human-friendly order reference shown as "#12"
  number            Int            @unique @default(autoincrement())
  /// Nullable so purging a customer keeps their orders (and revenue history).
  customerId        String?
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Snapshot of who ordered, still shown after the customer is deleted.
  customerName      String
  customerPhone     String
  status            OrderStatus    @default(PLACED)
  fulfilmentType    FulfilmentType
  deliveryAddress   String?
  /// Pin dropped by the customer (current location / map search), for Google Maps directions.
  deliveryLat       Float?
  deliveryLng       Float?
  /// Delivery partner (an Admin with role DELIVERY) assigned by the store.
  deliveryPartnerId String?
  deliveryPartner   Admin?         @relation("DeliveryAssignments", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  /// When the order went out for delivery (or became ready for pickup).
  dispatchedAt      DateTime?
  deliveredAt       DateTime?
  /// Delivery charge on this order: the store's charge at order time, or a
  /// custom amount an admin set afterwards. Included in the payment amount.
  deliveryFee       Decimal        @default(0) @db.Decimal(10, 2)
  /// Set when the customer taps "I received my order".
  receivedAt        DateTime?
  scheduledDeleteAt DateTime?
  createdAt         DateTime       @default(now())
  items             OrderItem[]
  payment           Payment?
  notifications     Notification[]

  @@index([customerId, createdAt])
  @@index([deliveryPartnerId, status])
  @@index([createdAt])
  @@index([scheduledDeleteAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Nullable so a permanently deleted product doesn't take order history with it.
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Snapshot of the product name at order time.
  productName  String
  qty          Int
  priceAtOrder Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

model Payment {
  id                 String         @id @default(cuid())
  orderId            String         @unique
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method             PaymentMethod
  amount             Decimal        @db.Decimal(10, 2)
  status             PaymentStatus  @default(PENDING)
  qrImageUrl         String?
  /// Other ways the store can tell the customer where to pay: a UPI ID, and
  /// bank details or any note. Any mix of QR, UPI ID and note may be sent.
  upiId              String?
  payNote            String?
  confirmedByAdminId String?
  confirmedBy        Admin?         @relation(fields: [confirmedByAdminId], references: [id], onDelete: SetNull)
  confirmedAt        DateTime?
  createdAt          DateTime       @default(now())
  proofs             PaymentProof[]

  @@index([status, method])
  @@index([confirmedAt])
}

/// A screenshot the customer uploaded to show they paid a UPI order. Staff
/// look at it, then confirm the payment themselves.
model PaymentProof {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  imageUrl  String
  createdAt DateTime @default(now())

  @@index([paymentId])
}

model AuditLog {
  id                String    @id @default(cuid())
  /// Null once the account that did this has been deleted; the log entry stays.
  actorAdminId      String?
  actor             Admin?    @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)
  /// Who it was, written down when their account is deleted.
  actorName         String?
  action            String
  targetId          String
  /// Human-readable context, e.g. "customer Ravi (98xxxxxx)".
  details           String?
  /// Set by a data reset: hidden now, removed when the time passes.
  scheduledDeleteAt DateTime?
  createdAt         DateTime  @default(now())

  @@index([createdAt])
}

/// Single-row store configuration (id is always 1), edited by the super admin.
model StoreSettings {
  id                Int      @id @default(1)
  pickupAddress     String?
  pickupLat         Float?
  pickupLng         Float?
  /// Charge added to every delivery order (0 = free delivery).
  deliveryFee       Decimal  @default(0) @db.Decimal(10, 2)
  /// Delivery is free when the items are worth at least this much (null = never free).
  freeDeliveryAbove Decimal? @db.Decimal(10, 2)
  /// A customer's link closes this many seconds after their order is finished
  /// (0 = at once, null = never).
  linkCloseAfterSec Int?     @default(120)
  /// Saved once, auto-applied to every new UPI order so the QR/UPI ID/bank
  /// details don't need re-uploading each time. Replaceable anytime.
  payQrImageUrl     String?
  payUpiId          String?
  payNote           String?
  updatedAt         DateTime @updatedAt
}

/// Where a delivery partner's phone was. Their app sends it only while they
/// have an order out for delivery; rows are kept for a few days.
model LocationPing {
  id        Int      @id @default(autoincrement())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  /// How exact the fix is, in metres.
  accuracy  Float
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}

/// In-app notification for exactly one recipient: a staff account or a customer.
model Notification {
  id         String    @id @default(cuid())
  adminId    String?
  admin      Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Machine-readable event, e.g. "new_order", "qr_ready", "delivered".
  type       String
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
}

/// A browser's Web Push subscription, owned by a staff account or a customer.
model PushSubscription {
  id         String    @id @default(cuid())
  endpoint   String    @unique
  p256dh     String
  auth       String
  adminId    String?
  admin      Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([customerId])
}
