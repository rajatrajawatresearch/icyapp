# Postgres (local, Neon or Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/icyapp?schema=public"
# Random 32+ byte secret used to sign admin session cookies: openssl rand -hex 32
AUTH_SECRET=""

